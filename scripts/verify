#!/bin/sh
# Canonical method checks. Suites are sequential; native proof stays isolated.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
usage() {
  printf '%s\n' \
    'Usage: scripts/verify [all]' \
    '       scripts/verify plugin [--strict] [--lint-only]' \
    '' \
    'all: maintained tests and structural lint; no native installation.' \
    'plugin: maintained tests and isolated Claude, Codex and pi install checks.' \
    '' \
    'Plugin-only options:' \
    '  --strict       Fail on broken relative Markdown links and unknown skill names.' \
    '  --lint-only    Skip every native installation explicitly (CI structural proof only).' \
    '' \
    '-h, --help: show this help. Install checks make no model inference request.' \
    'Missing harness CLIs report SKIP, never PASS; available CLIs must pass their native checks.'
}
bad_usage() { usage >&2; exit 1; }
selection=${1:-all}
if [ "$#" -gt 0 ]; then shift; fi
case "$selection" in
  all) [ "$#" -eq 0 ] || bad_usage; set -- --lint-only ;;
  plugin) ;;
  -h|--help) [ "$#" -eq 0 ] || bad_usage; usage; exit 0 ;;
  *) bad_usage ;;
esac
for tool in git bun python3; do
  command -v "$tool" >/dev/null 2>&1 || { echo "$tool is required" >&2; exit 1; }
done
mkdir -p "$HOME/.cache/tmp"
work=$(mktemp -d "$HOME/.cache/tmp/mistystack-verify.XXXXXX")
trap 'rm -rf -- "$work"' 0
trap 'exit 130' 2
trap 'exit 143' 15
export TMPDIR="$work"
printf 'Source: %s (%s)\n' "$(git rev-parse HEAD)" "$selection"
if [ -n "$(git status --porcelain)" ]; then
  printf 'Note: plugin proof and tests read working files.\n'
fi
for script in scripts/bootstrap scripts/check scripts/verify .githooks/pre-commit .githooks/pre-push; do
  sh -n "$script"
done
bun scripts/stamp-version.ts --check
bun scripts/verify-plugin.ts "$@"
printf 'Verification complete: %s\n' "$selection"
