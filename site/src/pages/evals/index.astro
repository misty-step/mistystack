---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HeadlineText from '../../components/HeadlineText.astro';
import EvalSummary from '../../components/EvalSummary.astro';
import { getGraph } from '../../lib/content.mjs';
const graph = await getGraph();
const rounds = graph.documents.filter((document) => document.kind === 'Evals').sort((a, b) => b.data.date.localeCompare(a.data.date));
---
<SiteLayout title="Evals" section="Evals">
  <div class="frame page">
    <section class="page-head">
      <h1 class="page-title"><HeadlineText text="Evals" stop /></h1>
      <p class="lede">Measured rounds with their task denominators, method and evidence boundaries. Directional results are not a claim of statistically conclusive superiority.</p>
      <p class="status">Read <a class="sp-link" href="/library/skills/agent-design/#instruction-eval">Misty's instruction-eval rule</a>.</p>
    </section>
    <ol class="entries eval-rounds" role="list">{rounds.map((document) => <li class="entry">
      <p class="entry-meta"><time datetime={document.data.date}>{document.data.date}</time> · {document.data.status}</p>
      <p class="entry-body">Harness: {document.data.harness}. Evidence: {document.data.evidence.map((item) => `${item.label} (${item.visibility})`).join('; ')}.</p>
      <EvalSummary {document} />
    </li>)}</ol>
  </div>
</SiteLayout>
