---
import { icon, statusIcon } from '@misty-step/brand/spine';
import SiteLayout from '../../layouts/SiteLayout.astro';
import HeadlineText from '../../components/HeadlineText.astro';
import { MAX_QUERY_LENGTH } from '../../lib/skill-search.mjs';
import '../../styles/find.css';
const intro = 'Describe a task. Jev ranks every skill mistystack ships or recommends by how well it fits.';
---
<SiteLayout title="Find a skill" section="Find" description={intro} noindex>
  <div class="frame tool">
    <div class="tool-panel">
      <h1 class="page-title"><HeadlineText text="Find a skill" stop /></h1>
      <p class="lede">{intro}</p>
      <form class="sp-card tool-form find-form" action="/find/" method="get" role="search" novalidate data-find-form>
        <div class="sp-field"><label class="sp-label" for="find-q">Task</label><textarea class="sp-input" id="find-q" name="q" rows="3" autocomplete="off" enterkeyhint="search" data-max-length={MAX_QUERY_LENGTH} placeholder="Try “review a pull request for security issues”"></textarea><p class="sp-field-note" id="find-q-error" hidden></p></div>
        <button class="sp-button" type="submit">Find skills</button>
      </form>
      <noscript><p class="status">The skill finder needs JavaScript. <a class="sp-link" href="/library/">Browse the library</a> instead.</p></noscript>
      <div class="find-summary">
        <p class="status"><span role="status" aria-live="polite" data-find-status></span><span class="find-elapsed" aria-hidden="true" data-find-elapsed></span></p>
        <p class="status" data-find-note hidden>Closeness is Jev’s judgment of relevance, not of correctness.</p>
        <p class="status find-run" data-find-run hidden></p>
      </div>
    </div>
    <div class="tool-results find-results">
      <ol class="sp-ranked" aria-label="Ranked skills" data-find-results></ol>
      <button class="sp-secondary tool-more" type="button" data-find-more hidden>Show more skills</button>
      <span class="sp-sr" role="status" data-find-announce></span>
      <template data-find-template="result">
        <li class="sp-ranked-result">
          <h2 class="sp-ranked-name" data-slot="name"></h2>
          <p class="sp-closeness"><meter min="0" max="1" value="0" aria-hidden="true" data-slot="bar"></meter><span><span class="sp-sr">Closeness </span><span data-slot="percent"></span></span></p>
          <p class="sp-ranked-description" data-slot="description"></p>
          <div class="sp-ranked-source">
            <span class="sp-tag find-source" data-slot="source"><span data-slot="pack"></span><code data-slot="pin"></code></span>
            <div class="find-commands" data-slot="commands"></div>
          </div>
        </li>
      </template>
      <template data-find-template="command">
        <div class="sp-command find-command"><code data-slot="text"></code><button class="sp-ghost" type="button" data-find-copy><Fragment set:html={icon('copy')} /><span data-slot="label">Copy</span><span class="sp-sr" data-slot="what"></span></button></div>
      </template>
      <template data-find-template="placeholder">
        <li class="find-placeholder" aria-hidden="true"><span class="sp-skeleton find-skeleton-title"></span><span class="sp-skeleton find-skeleton-bar"></span><span class="sp-skeleton find-skeleton-short"></span></li>
      </template>
      <template data-find-template="warn"><Fragment set:html={statusIcon('warn')} /></template>
      <template data-find-template="err"><Fragment set:html={statusIcon('err')} /></template>
    </div>
  </div>
  <script>import '../../scripts/find.mjs';</script>
</SiteLayout>
