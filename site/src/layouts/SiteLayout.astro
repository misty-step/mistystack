---
import '@misty-step/brand/brand.css';
import '@misty-step/brand/spine.css';
import '../styles/site.css';
import { HTML_ATTRS } from '@misty-step/brand/attrs';
import { lockup } from '@misty-step/brand/mark';
import { icon } from '@misty-step/brand/spine';
import faviconSvg from '@misty-step/brand/identity/icons/favicon.svg?url';
import favicon32 from '@misty-step/brand/identity/icons/favicon-32.png?url';
import appIcon from '@misty-step/brand/identity/icons/app-180-ink.png?url';
import ogCard from '@misty-step/brand/identity/og/stack.png?url';
import { home } from '../copy/home.mjs';
import { canonical, release, repositoryUrl } from '../lib/release.mjs';
const links = [{ href: '/guide/', label: 'Guide' }, { href: '/library/', label: 'Library' }, { href: '/find/', label: 'Find a skill' }, { href: '/evals/', label: 'Evals' }, { href: '/search/', label: 'Search' }];
const { title, description = 'A small always-on core, one routing skill and proof on the real running path.', section = 'About', path = Astro.url.pathname, noindex = false, nav = links, navCta = { href: '/install/', label: 'Install' } } = Astro.props;
const more = [{ href: '/install/', label: 'Install' }, { href: '/foundation/', label: 'Foundation' }, { href: '/decisions/', label: 'Decisions' }, { href: repositoryUrl, label: 'GitHub' }];
const footer = [{ href: 'https://mistystep.io', label: 'Misty Step' }, { href: repositoryUrl, label: 'Source' }, ...links.slice(1), { href: '/foundation/', label: 'Foundation' }, { href: '/decisions/', label: 'Decisions' }, { href: '/spec/', label: 'Spec' }, { href: '/exemplars/', label: 'Exemplars' }, { href: '/attribution/', label: 'Attribution' }, { href: '/changelog/', label: 'Changelog' }];
const selected = (href) => (path.startsWith(href) ? 'page' : undefined);
const fullTitle = title === 'mistystack' ? title : `${title} | mistystack`;
const url = new URL(path, canonical);
---
<!doctype html>
<html lang="en" {...HTML_ATTRS}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline src="/theme-init.js"></script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta data-pagefind-filter="section[content]" content={section} />
    <meta data-pagefind-meta="title[content]" content={title} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={faviconSvg} type="image/svg+xml" />
    <link rel="icon" href={favicon32} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={appIcon} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="mistystack" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(ogCard, canonical)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="sp-skip" href="#main">Skip to content</a>
    <header class="masthead" data-pagefind-ignore>
      <div class="frame masthead-bar">
        <Fragment set:html={lockup('mistystack', { href: '/', label: 'mistystack home' })} />
        <nav class="masthead-links" aria-label="Primary">{nav.map((link) => <a href={link.href} aria-current={link.href.startsWith('/') ? selected(link.href) : undefined}>{link.label}</a>)}</nav>
        <div class="masthead-actions">
          <button class="sp-ghost sp-icon-only" type="button" data-theme-toggle aria-pressed="false" aria-label="Dark theme"><Fragment set:html={icon('moon')} /></button>
          <a class="sp-button masthead-cta" href={navCta.href}>{navCta.label}</a>
          <details class="nav-menu">
            <summary class="sp-secondary">Menu</summary>
            <nav aria-label="Menu"><ul role="list">{[...links, ...more].map((link) => <li><a href={link.href} aria-current={link.href.startsWith('/') ? selected(link.href) : undefined}>{link.label}</a></li>)}</ul></nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1" data-pagefind-body={!noindex || undefined} data-pagefind-ignore={noindex ? 'all' : undefined}><slot /></main>
    <footer class="site-foot" data-pagefind-ignore>
      <div class="frame site-foot-grid">
        <p class="site-foot-line">{home.footer.line}</p>
        <nav class="site-foot-links" aria-label="Footer">{footer.map((link) => <a href={link.href}>{link.label}</a>)}</nav>
        <p class="site-foot-release">Site source <a class="sp-link" href={`${repositoryUrl}/tree/${release.commit}`}><code>{release.commit.slice(0, 7)}</code></a> · Method package <span class="site-foot-version">{release.version}</span> · <a class="sp-link" href="/release.json">Release record</a></p>
      </div>
    </footer>
    <script>import '../scripts/site.mjs';</script>
  </body>
</html>
