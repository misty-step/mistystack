---
const { document } = Astro.props;
const round = document.data;
---
<section class="eval-summary" aria-label={round.title}>
  <h2><a class="sp-link" href={document.url}>{round.title}</a></h2>
  <p>{round.taskCount} replayed tasks · {round.model} · {round.thinking} · {round.judge}</p>
  <div class="sp-plate" tabindex="0" role="region" aria-label="Evaluation results, scroll horizontally if needed">
    <table class="sp-table">
      <caption>Reported outside-check passes, not an independent rerun</caption>
      <thead><tr><th scope="col">Guidance arm</th><th scope="col" class="num">Passed / tasks</th><th scope="col" class="num">Mean blind score / 20</th><th scope="col" class="num">Tokens</th></tr></thead>
      <tbody>{round.arms.map((arm) => <tr><th scope="row">{arm.label}</th><td class="num">{arm.oraclePassed}/{arm.oracleTotal}</td><td class="num">{arm.meanBlindScore.toFixed(2)}</td><td class="num">{arm.tokens.toLocaleString('en-US')}</td></tr>)}</tbody>
    </table>
  </div>
  <div><h3>Limits on this result</h3><ul class="limits">{round.limits.map((limit) => <li>{limit}</li>)}</ul></div>
  <p><a class="sp-link" href={document.url}>Read the task table, method and evidence boundaries</a></p>
</section>
